{# Top prev/next navigation — same as Helios prev-next.html.twig but with --top modifier #}
{% set prev = doc_prev|default(null) %}
{% set next = doc_next|default(null) %}

{% if (prev or next) and not chromeless %}
{# On a publication's first page (no Previous page), data-hor-home-url is the publication's home page, where the left
   arrow key goes (assets/helios.js), as in Grav Open Publishing Space #}
<nav class="prev-next-nav prev-next-nav--top" aria-label="{{ 'PLUGIN_HELIOS_OPEN_READER.PAGE_NAVIGATION_TOP'|t|e('html_attr') }}"{% if not prev and page.template in ['section', 'section-page'] and (publication_home_url|default(null) or section_home_url|default(null)) %} data-hor-home-url="{{ (publication_home_url|default(null) ?: section_home_url)|e('html_attr') }}"{% endif %}>
    {% if prev %}
    <a href="{{ prev.url }}" class="nav-button prev group">
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <div>
            <span class="label">{{ 'THEME_HELIOS.PREVIOUS'|t }}</span>
            <span class="title block">{{ prev.title }}</span>
        </div>
    </a>
    {% else %}
    <div></div>
    {% endif %}

    {% if next %}
    <a href="{{ next.url }}" class="nav-button next group">
        <div>
            <span class="label">{{ 'THEME_HELIOS.NEXT'|t }}</span>
            <span class="title block">{{ next.title }}</span>
        </div>
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </a>
    {% endif %}
</nav>
{% endif %}
