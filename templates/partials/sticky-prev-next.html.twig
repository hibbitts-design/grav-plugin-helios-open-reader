{# Sticky compact prev/next bar — mirrors nav-button structure from prev-next.html.twig.
   Shown via JS (IntersectionObserver) when both main nav blocks are off-screen.
   Suppressed in chromeless/embedded mode. #}
{# (an explicit check, as |default(true) would also turn a false setting into true) #}
{% if not chromeless and (hor_show_sticky_nav is not defined or hor_show_sticky_nav) %}
{% set prev = doc_prev|default(null) %}
{% set next = doc_next|default(null) %}
{% if prev or next %}
<div class="hor-sticky-nav not-prose" id="hor-sticky-nav" aria-hidden="true" inert>
    {# On a publication's first page (no Previous page), the left arrow key goes back to the publication's home page
       (assets/helios.js reads its address from data-hor-home-url), as in Grav Open Publishing Space. hor_home_url is
       that address, and stays empty on every other page #}
    {% set hor_home_url = null %}
    {% if not prev and page.template in ['section', 'section-page'] %}
        {% set hor_home_url = publication_home_url|default(null) ?: section_home_url|default(null) %}
    {% endif %}
    <nav class="prev-next-nav" aria-label="{{ 'PLUGIN_HELIOS_OPEN_READER.PAGE_NAVIGATION_BAR'|t|e('html_attr') }}"{% if hor_home_url %} data-hor-home-url="{{ hor_home_url|e('html_attr') }}"{% endif %}>
        {% if prev %}
        <a href="{{ prev.url }}" class="nav-button prev group" tabindex="-1">
            <svg class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            <div>
                <span class="label">{{ 'THEME_HELIOS.PREVIOUS'|t }}</span>
                <span class="title block">{{ prev.title }}</span>
            </div>
        </a>
        {% endif %}
        {% if next %}
        <a href="{{ next.url }}" class="nav-button next group" tabindex="-1">
            <div>
                <span class="label">{{ 'THEME_HELIOS.NEXT'|t }}</span>
                <span class="title block">{{ next.title }}</span>
            </div>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </a>
        {% endif %}
    </nav>
</div>
{% endif %}
{% endif %}
