{#
 # Base Simple Wide Template
 # A wider variant of the theme's base-simple.html.twig for pages that need
 # more horizontal space (e.g. a content column + page ToC side column).
 # Identical to base-simple.html.twig except:
 #   - The <main> uses max-width: 72rem instead of max-w-4xl (56rem)
 #   - PLUGIN CHANGE 1 — suppress header when chromeless=true
 #   - PLUGIN CHANGE 2 — suppress footer when chromeless=true
 #   - PLUGIN CHANGE 3 — propagate chromeless/embedded param to all internal links
 #
 # Derived from: user/themes/helios/templates/partials/base-simple.html.twig
 # Plugin copy — update when the theme's base-simple.html.twig changes.
 #}
{% set theme_config = config.themes.helios %}
{% set appearance = theme_config.appearance %}
{% set is_htmx = is_htmx_request|default(false) %}

{# For HTMX requests, return only the content partial #}
{% if is_htmx %}
    {% include 'partials/htmx-content.html.twig' %}
{% else %}

<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: 'en' }}"
      x-data="{
          searchOpen: false,
          theme: localStorage.getItem('helios-theme') || '{{ appearance.theme }}'
      }"
      :class="{ 'dark': theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches) }">
<head>
    <script>
        // Prevent FOUC: Apply dark mode immediately before page renders
        (function() {
            var theme = localStorage.getItem('helios-theme') || '{{ appearance.theme }}';
            var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) document.documentElement.classList.add('dark');
        })();
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>

    {% if page.description %}
    <meta name="description" content="{{ page.description }}">
    {% endif %}

    {% if page.robots %}
    <meta name="robots" content="{{ page.robots }}">
    {% endif %}

    {# Open Graph meta tags #}
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url(true) }}">
    <meta property="og:title" content="{{ page.title }}{% if site.title %} | {{ site.title }}{% endif %}">
    {% set og_description = page.header.subtitle|default(page.header.description)|default(page.description) %}
    {% if og_description %}
    <meta property="og:description" content="{{ og_description|striptags }}">
    {% endif %}
    {% if page.header.cover_image %}
        {% set og_cover = page.media[page.header.cover_image] %}
        {% if og_cover %}
        {% set og_image_url = og_cover.url(true) %}
        {% set og_origin = grav.uri.scheme ~ grav.uri.host ~ (grav.uri.port ? ':' ~ grav.uri.port : '') %}
        <meta property="og:image" content="{{ og_image_url starts with 'http' ? og_image_url : og_origin ~ og_image_url }}">
        {% endif %}
    {% endif %}

    {# Favicon #}
    {% if theme_config.custom_favicon %}
        {% set favicon = theme_config.custom_favicon|first %}
        <link rel="icon" href="{{ url('user://assets/helios/' ~ favicon.name) }}">
    {% else %}
        <link rel="icon" type="image/svg+xml" href="{{ url('theme://images/favicon.svg') }}">
    {% endif %}

    {# CSS Variables for theming #}
    {% include 'partials/variables.html.twig' %}

    {{ assets.css()|raw }}
</head>

{% set shortcut_key = theme_config.search.shortcut_key|default('k') %}
<body class="min-h-screen bg-white dark:bg-gray-950/93 text-gray-900 dark:text-gray-100 {{ theme_config.body_classes }}"
      @keydown.window="if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === '{{ shortcut_key }}') { event.preventDefault(); searchOpen = true; }"
      @keydown.window.escape="searchOpen = false">

    {# Skip to content link for accessibility #}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg">
        {{ 'PLUGIN_HELIOS_OPEN_READER.SKIP_TO_CONTENT'|t }}
    </a>

    {# Search modal - only use yetisearch-pro if plugin is actually enabled #}
    {% if theme_config.search.enabled %}
        {% if theme_config.search.provider == 'yetisearch-pro' and config.plugins['yetisearch-pro'].enabled %}
            {% include 'partials/yetisearch-pro/modal.html.twig' %}
        {% else %}
            {% include 'partials/search-modal.html.twig' %}
        {% endif %}
    {% endif %}

    {# Header — PLUGIN CHANGE 1: suppressed when chromeless=true #}
    {% if not chromeless %}
    {% include 'partials/header-simple.html.twig' %}
    {% endif %}

    {# Main content — wider than base-simple: 48rem content + --helios-toc-width + gap-8 (2rem) #}
    <main id="main-content" class="mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" style="max-width: calc(48rem + var(--helios-toc-width, 15rem) + 2rem);">
        {% block content %}{% endblock %}
    </main>

    {# Footer — PLUGIN CHANGE 2: suppressed when chromeless=true #}
    {% if not chromeless %}
    {% include 'partials/footer.html.twig' %}
    {% endif %}

    {# Head-group JS (core/plugin scripts like the PHP debug bar and its jQuery) — carried over from Helios theme v2.1.15. #}
    {{ assets.js('head')|raw }}
    {{ assets.js('bottom')|raw }}

    {# PLUGIN CHANGE 3 — propagate chromeless/embedded param to all internal links #}
    {% if chromeless %}
    <script>
    (function () {
        var params = new URLSearchParams(window.location.search);
        var paramName = params.has('embedded') ? 'embedded' : 'chromeless';

        function rewriteLinks() {
            document.querySelectorAll('a[href]').forEach(function (a) {
                var href = a.getAttribute('href');
                if (!href || href.charAt(0) === '#' || /^(mailto|tel|javascript):/i.test(href)) return;
                try {
                    var u = new URL(a.href, window.location.origin);
                    if (u.origin !== window.location.origin) return;
                    u.searchParams.set(paramName, 'true');
                    a.setAttribute('href', u.pathname + (u.search || '') + (u.hash || ''));
                } catch (e) {}
            });
        }

        rewriteLinks();
    })();
    </script>
    {% endif %}
</body>
</html>
{% endif %}{# end is_htmx check #}
