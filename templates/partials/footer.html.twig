{#
 # Plugin override of partials/footer.html.twig (helios theme)
 # Changes from theme original:
 #   1. git_path_prefix uses github_server plugin variable to support GitHub and Codeberg view/edit links (search: PLUGIN CHANGE 1)
 #   2. OER attribution block displayed when show_oer_attribution is enabled (search: PLUGIN CHANGE 2)
 #   3. Footer attribution text includes Helios Open Reader link, toggled by show_plugin_credits (search: PLUGIN CHANGE 3)
 #   4. Git edit link suppressed via ?edit_link=false or ?hidegitlink=true URL params (search: PLUGIN CHANGE 4)
 #   5. Strip leading user/ from file_path after prefix removal — skeleton repos have pages/ at root,
 #      not user/pages/; JS in helios.js updates this link on HTMX navigation (PLUGIN CHANGE 5)
 #   6. Plain text version link with optional icon, linking to /llms-full.txt; shown on each publication's home page.
 #      Links to that reader's own file on multi-publication sites, or Sitemap's site-wide file on
 #      single-publication sites when its "Serve llms-full.txt" setting is enabled (PLUGIN ADDITION)
 #   7. "This page as Markdown" link to the page's own Markdown (page address + .md), updated by helios.js on HTMX
 #      navigation (PLUGIN ADDITION)
 #   8. The page links and credits are asides (secondary information, which Grav 2's Markdown output leaves out),
 #      so a page's .md has its content and attribution only (PLUGIN CHANGE 8)
 #}
<footer class="mt-16 py-8 border-t border-gray-200 dark:border-gray-700">

    {# View/Edit on GitHub/Codeberg link #}
    {% if theme_config.github.enabled and theme_config.github.edit_link and not hide_git_link %}{# PLUGIN CHANGE 4 #}
    {% set file_path = page.filePathClean %}
    {% set prefix = theme_config.github.path_prefix %}
    {% if prefix and file_path starts with prefix %}
        {% set file_path = file_path[prefix|length:] %}
    {% endif %}
    {% if file_path starts with 'user/' %}{% set file_path = file_path[5:] %}{% endif %}{# PLUGIN CHANGE 5 #}
    {% set git_path_prefix = (github_server == 'github.com') ? (github_link_mode == 'edit' ? 'edit' : 'blob') : (github_link_mode == 'edit' ? '_edit' : 'src/branch') %}{# PLUGIN CHANGE 1 #}
    <aside class="mb-4 text-center" aria-label="Page source">
        <a href="https://{{ github_server }}/{{ theme_config.github.repo|trim('/') }}/{{ git_path_prefix }}/{{ theme_config.github.branch }}/{{ file_path }}"
           target="_blank"
           rel="noopener noreferrer"
           class="edit-page-link inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary">
            <span aria-hidden="true">{{ svg_icon(github_link_icon ?: 'tabler/file-text.svg', 'w-4 h-4')|raw }}</span>
            {{ theme_config.github.edit_text ?: 'THEME_HELIOS.EDIT_PAGE'|t }}<span class="sr-only"> (opens in new tab)</span>
        </a>
    </aside>
    {% endif %}

    {# "This page as Markdown" link: just this page's Markdown (the full text link below covers the whole
       publication). The footer isn't re-rendered when readers move between pages, so it's always here when
       turned on (hidden where it doesn't apply), and helios.js updates its address from the
       data-hor-markdown-url marker in each page's content #}{# PLUGIN ADDITION #}
    {% if show_markdown_link %}
    {% set hor_markdown_url = include('partials/markdown-url.html.twig')|trim %}
    <aside class="hor-markdown-link-wrap mb-4 text-center text-sm text-gray-500 dark:text-gray-400" aria-label="{{ markdown_link_label }}"{% if not hor_markdown_url %} hidden{% endif %}>
        {# the hover text shares a tip: any page's Markdown is at its address with .md added #}
        <a href="{{ hor_markdown_url }}" title="Add .md to any page's address to get its Markdown" class="page-markdown-link plain-text-link inline-flex items-center gap-1 hover:underline">
            {% if markdown_link_icon %}<span aria-hidden="true">{{ svg_icon(markdown_link_icon, 'w-4 h-4')|raw }}</span>{% endif %}
            {{ markdown_link_label }}
        </a>
    </aside>
    {% endif %}

    {# Plain text version link — hidden on readers-list page; per-publication file on multi-pub sites,
       otherwise Sitemap's site-wide file when its own setting is enabled #}{# PLUGIN ADDITION #}
    {% if is_multi_publication and publication_base_path %}
        {% set llms_available = publication_llms_full_available %}
        {% set llms_url = base_url_absolute ~ publication_base_path ~ '/llms-full.txt' %}
    {% else %}
        {% set llms_available = llms_full_available %}
        {% set llms_url = base_url_absolute ~ '/llms-full.txt' %}
    {% endif %}
    {# shown only on each publication's home page (its Section List page), where readers think about the whole
       publication; reading pages have the "This page as Markdown" link instead #}
    {% if llms_available and show_plain_text_link and not chromeless and page.template == 'section-list' %}
    {% set show_oer = show_oer_attribution and reader_attribution %}
    <aside class="mt-4 {{ not show_oer ? 'mb-4' : '' }} text-center text-sm text-gray-500 dark:text-gray-400" aria-label="{{ plain_text_link_label }}">
        <a href="{{ llms_url }}" class="plain-text-link inline-flex items-center gap-1 hover:underline">
            {% if plain_text_link_icon %}<span aria-hidden="true">{{ svg_icon(plain_text_link_icon, 'w-4 h-4')|raw }}</span>{% endif %}
            {{ plain_text_link_label }}
        </a>
    </aside>
    {% endif %}

    {# OER attribution block #}{# PLUGIN CHANGE 2 #}
    {% if show_oer_attribution and reader_attribution and not chromeless %}
    <div class="hor-attribution mt-4 mb-4 text-center text-sm text-gray-500 dark:text-gray-400">
        <p>{{ reader_attribution|raw }}</p>
        {# the license on its own line, unless the attribution text already names it (as in "licensed under
           CC BY 4.0"), so it isn't shown twice - the same as in Grav Open Publishing Space #}
        {% set show_license_line = reader_license %}
        {% if reader_license and reader_license in reader_attribution %}
            {% set show_license_line = false %}
        {% endif %}
        {% if show_license_line %}
        <p class="mt-2">
            {% if reader_license_url %}
            <a href="{{ reader_license_url }}" target="_blank" rel="noopener noreferrer" class="hover:underline">
                {{ reader_license }}<span class="sr-only"> (opens in new tab)</span>
            </a>
            {% else %}
            {{ reader_license }}
            {% endif %}
        </p>
        {% endif %}
    </div>
    {% endif %}

    {# Plugin credits #}{# PLUGIN CHANGE 3 #}
    {% if show_plugin_credits and not chromeless %}
    <aside class="text-center text-sm text-gray-500 dark:text-gray-400" aria-label="Credits">Built with <a href="https://getgrav.org" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Grav<span class="sr-only"> (opens in new tab)</span></a> · <a href="https://getgrav.org/premium/helios" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Grav Premium Helios<span class="sr-only"> (opens in new tab)</span></a> theme · <a href="https://github.com/hibbitts-design/grav-plugin-helios-open-reader" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">Helios Open Reader<span class="sr-only"> (opens in new tab)</span></a> by <a href="https://hibbittsdesign.org" target="_blank" rel="nofollow noopener noreferrer" class="hover:underline">hibbittsdesign.org<span class="sr-only"> (opens in new tab)</span></a></aside>
    {% endif %}
</footer>
