{# Side Box (side_box), as in Grav Open Publishing Space: the page's own, else the guide home's (shown on every page of
   the guide); none on the pages of a section set to false. Used by sidebar.html.twig and swap-body.html.twig #}
{% if page.template in ['section-list', 'section', 'section-page'] %}

    {% if page.header.side_box is defined %}
        {% set side_box = page.header.side_box %}
    {% else %}
        {% set side_box = reader_side_box|default(null) %}
    {% endif %}

    {# the page's section has its Side Box turned off ("false" is also how Admin saves it) #}
    {% set section = page.parent %}
    {% set in_a_section = section.template == 'section' %}
    {% set section_turned_off = section.header.side_box is defined and (not section.header.side_box or section.header.side_box == 'false') %}
    {% if page.header.side_box is not defined and in_a_section and section_turned_off %}
        {% set side_box = false %}
    {% endif %}

    {% if side_box and side_box != 'false' %}
        {{ side_box|markdown|shortcodes|raw }}
    {% endif %}
{% endif %}
