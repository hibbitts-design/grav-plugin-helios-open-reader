{# Plugin override of Helios prev-next.html.twig
   On section and section-page templates: suppresses bottom nav when hor_prev_next_position is 'top' or 'none'.
   On all other templates: always renders the nav (position setting is section/section-page-only).
   Suppressed entirely when embedded (?embedded=true or ?chromeless=true). #}
{% if not chromeless and (hor_prev_next_position|default('both') in ['bottom', 'both'] or page.template not in ['section', 'section-page']) %}
{% set prev = doc_prev|default(null) %}
{% set next = doc_next|default(null) %}

{# (only when the Show Reading Progress setting is on) #}
{% if section_progress_current is defined and (hor_show_reading_progress is not defined or hor_show_reading_progress) %}
{% set progress_text = 'PLUGIN_HELIOS_OPEN_READER.PAGE_PROGRESS'|t(section_progress_current, section_progress_total) %}
{% if section_part_label is defined and section_part_label %}
    {% set progress_text = section_part_label ~ ' · ' ~ progress_text %}
{% endif %}
<div class="hor-progress">
    <div class="hor-progress-bar"
         role="progressbar"
         aria-label="{{ 'PLUGIN_HELIOS_OPEN_READER.READING_PROGRESS'|t|e('html_attr') }}"
         aria-valuenow="{{ section_progress_current }}"
         aria-valuemin="0"
         aria-valuemax="{{ section_progress_total }}"
         aria-valuetext="{{ progress_text }}">
        <div class="hor-progress-fill" aria-hidden="true" style="width: {{ ((section_progress_current / section_progress_total) * 100)|round }}%"></div>
    </div>
    <p class="hor-progress-text" aria-hidden="true">{{ progress_text }}</p>
</div>
{% endif %}

{% if prev or next %}
{# On a publication's first page (no Previous page), data-hor-home-url is the publication's home page, where the left
   arrow key goes (assets/helios.js), as in Grav Open Publishing Space #}
<nav class="prev-next-nav" aria-label="{{ 'PLUGIN_HELIOS_OPEN_READER.PAGE_NAVIGATION'|t|e('html_attr') }}"{% if not prev and page.template in ['section', 'section-page'] and (publication_home_url|default(null) or section_home_url|default(null)) %} data-hor-home-url="{{ (publication_home_url|default(null) ?: section_home_url)|e('html_attr') }}"{% endif %}>
    {% if prev %}
    <a href="{{ prev.url }}" class="nav-button prev group">
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <div>
            <span class="label">{{ 'THEME_HELIOS.PREVIOUS'|t }}</span>
            <span class="title block">{{ prev.title }}</span>
        </div>
    </a>
    {% else %}
    <div></div>
    {% endif %}

    {% if next %}
    <a href="{{ next.url }}" class="nav-button next group">
        <div>
            <span class="label">{{ 'THEME_HELIOS.NEXT'|t }}</span>
            <span class="title block">{{ next.title }}</span>
        </div>
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </a>
    {% endif %}
</nav>
{% endif %}
{% endif %}
