{# Inner content for section-card - section number, icon, title, arrow, description, author, edition, lastmod, badge, license #}
{% if section_number %}
<p class="text-xs font-medium text-primary uppercase tracking-wider mb-2">{{ section_label|default('Section') }} {{ section_number }}</p>
{% endif %}
<div class="flex items-center gap-3 text-base font-semibold text-gray-900 dark:text-white {{ link ? 'group-hover:text-primary' : '' }} transition-colors">
    {% if icon %}
    <span class="doc-card-icon flex-shrink-0 inline-flex items-center justify-center p-2 rounded-xl bg-primary/15 text-primary" aria-hidden="true">
        {{ svg_icon(icon, 'w-5 h-5')|raw }}
    </span>
    {% endif %}
    <span>{{ title }}</span>
    {% if link %}
    <svg class="ml-auto w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
    </svg>
    {% endif %}
</div>
{% if description or content %}
{% set clamp_class = description and card_description_lines > 0 ? 'section-card-description--clamp-' ~ card_description_lines : '' %}
<div class="section-card-description mt-3 text-sm text-gray-600 dark:text-gray-400 {{ clamp_class }}">
    {{ content|raw ?: description }}
</div>
{% endif %}
{% if author or edition %}
<div class="mt-2 text-sm text-gray-500 dark:text-gray-400">
    {% if author %}{{ author }}{% endif %}{% if author and edition %} &middot; {% endif %}{% if edition %}<span class="text-xs">{{ edition }}</span>{% endif %}
</div>
{% endif %}
{% if lastmod %}
<div class="mt-1 text-xs text-gray-400 dark:text-gray-500">Updated: {{ (lastmod|split(' ')|first)|date('M j, Y') }}</div>
{% endif %}
{% if badge_label or license %}
<div class="mt-3 flex flex-wrap gap-2">
    {% if badge_label %}
    {% set badge_color_class = badge_color and badge_color != 'default' ? 'doc-badge-' ~ badge_color : '' %}
    {% set badge_classes = ['doc-badge', badge_color_class]|filter(v => v)|join(' ') %}
    <span class="{{ badge_classes }}">{{ badge_label }}</span>
    {% endif %}
    {% if license %}
    <span class="doc-badge doc-badge--plain">{{ license }}</span>
    {% endif %}
</div>
{% endif %}
