{# Section card partial - doc-card variant with optional top or side image #}
{# Required vars: title, link (optional), icon (optional), description (optional), image (optional Grav media object), image_layout ('top'|'side', default 'top') #}
{% set tag = link ? 'a' : 'div' %}
{% set linkAttrs = link ? 'href="' ~ link ~ '"' : '' %}
{% set layout = image ? (image_layout|default('top')) : 'none' %}
{# a card with just a label and title (no image or details below the title) is marked, so its label and title
   can be centred in the card instead of leaving all the space below them (see section-list.css) #}
{% set title_only = not image and not description and not content and not author and not edition and not lastmod and not badge_label and not license %}

<{{ tag }} {{ linkAttrs|raw }} class="doc-card group block rounded-lg border border-gray-200 dark:border-gray-700 {{ link ? (image ? 'cursor-pointer hover:!no-underline' : 'hover:border-primary dark:hover:border-primary cursor-pointer hover:!no-underline') : '' }} transition-colors {{ image ? 'section-card-has-image' : '' }} {{ title_only ? 'section-card-title-only' : '' }} {{ layout == 'side' ? 'section-card-side-layout' : '' }}">
    {% if layout == 'top' %}
        <div class="section-card-image-container">
            <img src="{{ image.url }}" alt="">
        </div>
        <div class="p-6">
            {% include 'partials/section-card-content.html.twig' %}
        </div>
    {% elseif layout == 'side' %}
        <div class="section-card-side-image-container">
            <img src="{{ image.url }}" alt="">
        </div>
        <div class="p-6 section-card-side-content">
            {% include 'partials/section-card-content.html.twig' %}
        </div>
    {% else %}
        {% include 'partials/section-card-content.html.twig' %}
    {% endif %}
</{{ tag }}>
