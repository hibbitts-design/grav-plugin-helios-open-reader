{% extends helios_base_simple %}

{% block content %}
    {# Library home header — title and optional collection tagline only #}
    <header class="mb-8 pb-6 border-b border-gray-200 dark:border-gray-800">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
            {{ page.title }}
        </h1>
        {% if page.header.subtitle %}
        <p class="mt-2 text-xl text-gray-500 dark:text-gray-400">
            {{ page.header.subtitle }}
        </p>
        {% endif %}
    </header>

    {# Split page content above/below reader cards using === delimiter #}
    {% set raw = page.rawMarkdown() %}
    {% if '===' in raw %}
        {% set content_above = page.summary() %}
        {% set full = page.content %}
        {% set content_below = (full starts with content_above) ? (full|slice(content_above|length))|trim : null %}
    {% else %}
        {% set content_above = page.content %}
        {% set content_below = null %}
    {% endif %}

    {% if content_above|trim %}
        <article class="prose prose-lg dark:prose-invert max-w-none mb-8">
            {{ content_above|raw }}
        </article>
    {% endif %}

    {# Resume Reading strip — shown when any publication was previously visited #}
    <div id="hor-resume-reading" class="hor-resume-strip" data-hor-match-any hidden>
        <svg class="hor-resume-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
        </svg>
        <span class="hor-resume-text"><a id="hor-resume-btn" href="#">{{ 'PLUGIN_HELIOS_OPEN_READER.LAST_READ'|t }}: <span id="hor-resume-title"></span></a></span>
        <button type="button" class="hor-resume-dismiss" aria-label="Dismiss">&#x2715;</button>
    </div>

    {# Reader cards — one card per reader home page (section-list, scanned from root by PHP) #}
    {% if publication_pages is defined and publication_pages|length > 0 %}
    {% set cpr = page.header.cards_per_row|default(1)|int %}
    {% set colClass = {
        1: 'grid-cols-1',
        2: 'sm:grid-cols-2',
        3: 'sm:grid-cols-2 lg:grid-cols-3'
    } %}
    {% set gridClasses = 'section-card-grid grid gap-4 mb-8 ' ~ (colClass[cpr] ?? 'grid-cols-1') ~ ' ' ~ (cpr == 2 ? 'section-card-grid--cols-2' : (cpr == 3 ? 'section-card-grid--cols-3' : '')) %}

    {# Build groups: ungrouped publications first, then named groups in encounter order #}
    {% set ungrouped_pubs = [] %}
    {% set named_groups = {} %}
    {% for publication_page in publication_pages %}
        {% set g = publication_page.header.group|default('') %}
        {% if g %}
            {% set named_groups = named_groups|merge({(g): (named_groups[g]|default([]))|merge([publication_page])}) %}
        {% else %}
            {% set ungrouped_pubs = ungrouped_pubs|merge([publication_page]) %}
        {% endif %}
    {% endfor %}

    {# Ungrouped publications — no heading #}
    {% if ungrouped_pubs|length > 0 %}
    <div class="{{ gridClasses }}">
        {% for publication_page in ungrouped_pubs %}
            {% set cover = publication_page.header.cover_image ? publication_page.media[publication_page.header.cover_image] : null %}
            {% include 'partials/section-card.html.twig' with {
                title: publication_page.title,
                link: publication_page.url,
                icon: publication_page.header.card_icon|default(page.header.card_icon)|default(null),
                section_number: null,
                description: publication_page.header.subtitle|default(publication_page.header.description)|default(null),
                image: cover,
                image_layout: (cpr == 3) ? 'top' : page.header.card_image_layout|default('side'),
                card_description_lines: page.header.card_description_lines|default(3),
                author: publication_page.header.authors|default(null),
                edition: publication_page.header.edition|default(null),
                license: publication_page.header.license|default(null),
                license_url: publication_page.header.license_url|default(null),
                lastmod: publication_page.header.last_updated|default(null),
                badge_label: publication_page.header.badge_label|default(null),
                badge_color: publication_page.header.badge_color|default('default')
            } only %}
        {% endfor %}
    </div>
    {% endif %}

    {# Named groups — each with a heading above its card grid #}
    {% for group_label, group_pubs in named_groups %}
    <div class="hor-part-heading">
        <h2>{{ group_label }}</h2>
    </div>
    <div class="{{ gridClasses }}">
        {% for publication_page in group_pubs %}
            {% set cover = publication_page.header.cover_image ? publication_page.media[publication_page.header.cover_image] : null %}
            {% include 'partials/section-card.html.twig' with {
                title: publication_page.title,
                link: publication_page.url,
                icon: publication_page.header.card_icon|default(page.header.card_icon)|default(null),
                section_number: null,
                description: publication_page.header.subtitle|default(publication_page.header.description)|default(null),
                image: cover,
                image_layout: (cpr == 3) ? 'top' : page.header.card_image_layout|default('side'),
                card_description_lines: page.header.card_description_lines|default(3),
                author: publication_page.header.authors|default(null),
                edition: publication_page.header.edition|default(null),
                license: publication_page.header.license|default(null),
                license_url: publication_page.header.license_url|default(null),
                lastmod: publication_page.header.last_updated|default(null),
                badge_label: publication_page.header.badge_label|default(null),
                badge_color: publication_page.header.badge_color|default('default')
            } only %}
        {% endfor %}
    </div>
    {% endfor %}
    {% endif %}

    {# Page content below reader cards #}
    {% if content_below and content_below|trim %}
        <article class="prose prose-lg dark:prose-invert max-w-none mt-8">
            {{ content_below|raw }}
        </article>
    {% endif %}
{% endblock %}
